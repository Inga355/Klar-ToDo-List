{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klar",
  "version": "0.1.0",
  "identifier": "de.klar.todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main", "title":"Klar", "width":1280, "height":860, "minWidth":860, "minHeight":620, "backgroundColor":"#211f1d"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {"enable":true, "scope":["$APPDATA/**"]}
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Dein lokaler Aufgabenplaner",
    "windows": {"nsis": {"displayLanguageSelector":false, "languages":["German"], "installerHooks":"installer-hooks.nsh"}}
  }
}
