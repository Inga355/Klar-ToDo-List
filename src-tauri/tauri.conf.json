{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klar",
  "version": "0.2.0",
  "identifier": "de.klar.todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"label":"main", "title":"Klar", "theme":"Dark", "width":1280, "height":860, "minWidth":860, "minHeight":620, "backgroundColor":"#211f1d", "dragDropEnabled":false},
      {"label":"mini", "title":"Klar · Miniansicht", "theme":"Dark", "url":"index.html?mini=1", "width":390, "height":560, "minWidth":340, "minHeight":350, "visible":false, "skipTaskbar":true, "backgroundColor":"#2a2520", "dragDropEnabled":false}
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {"enable":true, "scope":["$APPDATA/**"]}
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Dein lokaler Aufgabenplaner",
    "windows": {"nsis": {"displayLanguageSelector":false, "languages":["German"], "installerHooks":"installer-hooks.nsh"}}
  }
}
